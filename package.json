{
  "name": "moss-bed",
  "version": "0.3.0",
  "description": "Moss-bed — React UI component library. Dark-first design system built with Tailwind CSS, Radix UI, and CVA. Originated in Petal (OllyGarden Cloud) and extracted for cross-product and external use.",
  "homepage": "https://github.com/ollygarden/moss-bed#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/components/ui/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/components/ui/index.d.ts"
    },
    "./tailwind-preset": {
      "import": "./dist/tailwind-preset.js",
      "types": "./dist/types/tailwind-preset.d.ts"
    },
    "./styles": "./dist/moss-bed-variables.css",
    "./link": {
      "import": "./dist/components/ui/Link/index.js",
      "types": "./dist/types/components/ui/Link/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ollygarden/moss-bed.git"
  },
  "bugs": {
    "url": "https://github.com/ollygarden/moss-bed/issues"
  },
  "keywords": [
    "react",
    "components",
    "ui",
    "tailwindcss",
    "radix-ui",
    "design-system",
    "figma-make",
    "moss-bed",
    "ollygarden"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "vite build && tsc -b tsconfig.lib.json --force && cp src/moss-bed-variables.css dist/moss-bed-variables.css",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0 || ^7.0.0",
    "react-hook-form": "^7.0.0",
    "@hookform/resolvers": "^3.0.0 || ^4.0.0 || ^5.0.0",
    "zod": "^3.0.0 || ^4.0.0",
    "tailwindcss": "^3.0.0 || ^4.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^2.0.0 || ^3.0.0",
    "lucide-react": "*",
    "react-datepicker": "^7.0.0 || ^8.0.0 || ^9.0.0",
    "motion": "^11.0.0 || ^12.0.0",
    "@radix-ui/react-checkbox": "^1.0.0",
    "@radix-ui/react-dialog": "^1.0.0",
    "@radix-ui/react-popover": "^1.0.0",
    "@radix-ui/react-scroll-area": "^1.0.0",
    "@radix-ui/react-toast": "^1.0.0",
    "@radix-ui/react-toggle-group": "^1.0.0",
    "@radix-ui/react-tooltip": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "react-datepicker": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@storybook/addon-docs": "^10.4.3",
    "@storybook/addon-links": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-storybook": "^10.4.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "lucide-react": "1.16.0",
    "motion": "^12.38.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.77.0",
    "react-router-dom": "^7.15.1",
    "storybook": "^10.4.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.13",
    "vitest": "~4.1.6",
    "zod": "^4.4.3"
  }
}
